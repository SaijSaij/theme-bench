{
    "name": "webcodingcat/bench-plugin",
    "description": "Plugin of the benchmark of wp-app-framework.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.5",
        "webcodingcat/wp-app-framework": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "WebCodingCat\\BenchPlugin\\": "src/"
        }
    },
    "scripts": {
        "build-manifest": "wp-app-framework build",
        "release": "wp-app-framework release"
    },
    "extra": {
        "wp-app-framework": {
            "namespace": "bench-plugin"
        },
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "WebCodingCat\\BenchPlugin\\Vendor\\",
            "classmap_prefix": "WebCodingCat_BenchPlugin_Vendor_",
            "include_root_autoload": true,
            "update_call_sites": [
                "src",
                "bench-plugin.php"
            ],
            "delete_vendor_packages": false
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "require-dev": {},
    "scripts-descriptions": {
        "build-manifest": "Builds and checks the manifest (writes nothing).",
        "release": "Builds the release ZIP into dist/."
    }
}
