# Development files: needed to build and run the benchmark, not shipped in the release ZIP
# (wp-app-framework release removes every path marked export-ignore).
# Directories are matched as dir/** so the attribute applies to the files inside.
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/CLAUDE.md export-ignore
/README.md export-ignore
/baseline/** export-ignore
/bin/** export-ignore
/phpstan.dist.neon export-ignore
/timer/** export-ignore
/webpack.config.js export-ignore
