<div {{ block_wrapper_attributes({class: 'card card--' ~ attrs.tone.value, style: attrs.accent ? 'border-color: ' ~ attrs.accent : ''}) }}>
    <h3{{ field('title') }}>{{ attrs.title }}</h3>
    <ul>
        {% for link in attrs.links %}
            <li{{ list_item(['links', loop.index0]) }}><a href="{{ link.url }}"{{ field('links.' ~ loop.index0 ~ '.label') }}>{{ link.label }}</a></li>
        {% endfor %}
    </ul>
</div>
